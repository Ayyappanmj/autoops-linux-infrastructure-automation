---
extends: default
rules:
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1
  line-length:
    max: 200
    level: warning
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  document-start: enable
ignore: |
  .git/
  .venv/
  reports/
