# Copy to .env (which is git-ignored). Contains PLACEHOLDERS only - never commit real values.
# Path to your SSH private key FILE (the key itself must never be stored in the repo)
AUTOOPS_SSH_KEY_PATH=~/.ssh/autoops_dev_ed25519
# Path to an Ansible Vault password FILE if you use Vault (optional)
ANSIBLE_VAULT_PASSWORD_FILE=~/.autoops_vault_pass
